============================================================
## ARCHITECTURE ##
============================================================

On the host where Suricata is installed:

/var/log/suricata/eve.json
        ↓
suricata-enricher.service
        ↓
/var/log/suricata/enriched.json
        ↓
   wazuh-agent



============================================================
## CREATE AN OUTPUT FILE FOR ENHANCED ALERTS ##
============================================================

bash:

install -o root -g root -m 644 /dev/null \
  /var/log/suricata/enriched.json



============================================================
## REQUIRED PERMISSIONS ##
============================================================

bash:

useradd --system --no-create-home --shell /usr/sbin/nologin suricata

apt -y install acl

setfacl -m u:suricata:rwx /var/log/suricata/
setfacl -m u:suricata:r /var/log/suricata/eve.json
setfacl -m u:suricata:rw /var/log/suricata/enriched.json

getfacl /var/log/suricata/enriched.json /var/log/suricata/



============================================================
## ENVIRONMENT SETUP ##
============================================================

bash:

mkdir -p /usr/local/etc/suricata-enricher/

apt -y install python3.13-venv

python3 -m venv /usr/local/etc/suricata-enricher/venv

source /usr/local/etc/suricata-enricher/venv/bin/activate

pip install --upgrade \
  google-genai \
  openai \
  anthropic \
  pydantic



