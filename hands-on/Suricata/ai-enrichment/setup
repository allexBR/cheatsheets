chmod 600 /etc/suricata/ai-engine/environment



============================================================
## SYSTEM SERVICE (Systemd) ##
============================================================

sudo systemctl edit --force --full suricata-enricher.service

[Unit]
Description=Suricata LLM Enricher
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=suricata
Group=suricata

EnvironmentFile=/etc/suricata/ai-engine/environment

ExecStart=/usr/local/etc/suricata-enricher/venv/bin/python \
          /usr/local/etc/suricata-enricher/ai_enricher.py

Restart=always
RestartSec=10

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target



systemctl daemon-reload
systemctl status suricata-enricher
systemctl enable --now suricata-enricher


============================================================
## AUTOMATION SCRIPT ##
============================================================

nano /usr/local/etc/suricata-enricher/ai_enricher.py

#!/usr/bin/env python3

import json
import os
import sys
import time
from abc import ABC, abstractmethod
from pathlib import Path
from typing import Any, Literal

from pydantic import BaseModel, Field


# Configuration

INPUT_FILE = Path(
    os.getenv(
        "SURICATA_INPUT",
        "/var/log/suricata/eve.json"
    )
)

OUTPUT_FILE = Path(
    os.getenv(
        "ENRICHED_OUTPUT",
        "/var/log/suricata/enriched.json"
    )
)

LLM_PROVIDER = os.getenv(
    "LLM_PROVIDER",
    "gemini"
).lower()

MAX_RETRIES = int(
    os.getenv("LLM_MAX_RETRIES", "3")
)

RETRY_SECONDS = int(
    os.getenv("LLM_RETRY_SECONDS", "10")
)


# Standardized Response Model

class EnrichmentResult(BaseModel):
    classification: Literal[
        "true_positive",
        "false_positive",
        "benign",
        "unknown"
    ]

    risk: Literal[
        "low",
        "medium",
        "high",
        "critical"
    ]

    confidence: float = Field(
        ge=0.0,
        le=1.0,
        description="Confiança da análise entre 0 e 1"
    )

    summary: str

    evidence: list[str]

    recommendations: list[str]

    mitre: list[str]

    needs_human_review: bool


# Prompt Sent to LLM Model

SYSTEM_INSTRUCTION = """
You are a SOC analyst specializing in Suricata and Wazuh.

OUTPUT LANGUAGE:

<!-- Change this to the desired language in the prompt output -->
ALWAYS respond in Brazilian Portuguese (pt-BR).
All text fields (summary, evidence, recommendations)
must be written in pt-BR.
The values for the fields classification, risk, confidence,
mitre, and needs_human_review follow the formats defined
below (do not translate them).

Analyze only the data provided.
Do not invent CVEs, reputation scores, malware, attribution, intent, or external facts.
If information cannot be verified, use “unknown.”

Do not take any actions.
Do not order blocks.
Do not recommend automatic host isolation.
Do not recommend automatic containment.

Classify the event as:

- true_positive
- false_positive
- benign
- unknown

Classify the risk as:

- low
- medium
- high
- critical

Confidence must be a number between 0 and 1.

Recommendations should be geared toward investigation,
validation, and human review.
"""


# Auxiliary Functions

def compact_json(data: Any) -> str:
    return json.dumps(
        data,
        ensure_ascii=False,
        separators=(",", ":")
    )


def read_secret(variable_name: str) -> str:
    value = os.getenv(variable_name)

    if not value:
        raise RuntimeError(
            f"The variable {variable_name} is not configured."
        )

    return value


def build_prompt(event: dict, asset_context: dict) -> str:
    payload = {
        "suricata_event": event,
        "asset": asset_context
    }

    return compact_json(payload)


def get_asset_context(event: dict) -> dict:
    """
    Minimum asset context.

    Replace this function if you want to query a CMDB or internal inventory.

    There is no Threat Intelligence query in this script.
    """

    return {
        "hostname": "unknown",
        "owner": "unknown",
        "criticality": "unknown",
        "internet_exposed": "unknown"
    }


def write_json_line(data: dict) -> None:
    OUTPUT_FILE.parent.mkdir(
        parents=True,
        exist_ok=True
    )

    with OUTPUT_FILE.open(
        "a",
        encoding="utf-8"
    ) as output:

        output.write(
            compact_json(data) + "\n"
        )

        output.flush()


# Common Provider Interface

class LLMProvider(ABC):

    @abstractmethod
    def analyze(
        self,
        event: dict,
        asset_context: dict
    ) -> EnrichmentResult:
        pass


# Google Gemini

class GeminiProvider(LLMProvider):

    def __init__(self):
        from google import genai

        self.model = os.getenv(
            "GEMINI_MODEL",
            "gemini-3.5-flash-lite"
        )

        self.client = genai.Client(
            api_key=read_secret(
                "GEMINI_API_KEY"
            )
        )

    def analyze(
        self,
        event: dict,
        asset_context: dict
    ) -> EnrichmentResult:

        from google.genai import types

        prompt = build_prompt(
            event,
            asset_context
        )

        response = self.client.models.generate_content(
            model=self.model,
            contents=prompt,
            config=types.GenerateContentConfig(
                system_instruction=SYSTEM_INSTRUCTION,
                temperature=0,
                response_mime_type="application/json",
                response_schema=EnrichmentResult
            )
        )

        parsed = getattr(
            response,
            "parsed",
            None
        )

        if parsed is not None:
            if isinstance(
                parsed,
                EnrichmentResult
            ):
                return parsed

            return EnrichmentResult.model_validate(
                parsed
            )

        response_text = getattr(
            response,
            "text",
            None
        )

        if not response_text:
            raise RuntimeError(
                "Gemini não retornou conteúdo."
            )

        return EnrichmentResult.model_validate_json(
            response_text
        )


# OpenAI

class OpenAIProvider(LLMProvider):

    def __init__(self):
        from openai import OpenAI

        self.model = os.getenv(
            "OPENAI_MODEL",
            "gpt-4o-mini"
        )

        self.client = OpenAI(
            api_key=read_secret(
                "OPENAI_API_KEY"
            )
        )

    def analyze(
        self,
        event: dict,
        asset_context: dict
    ) -> EnrichmentResult:

        prompt = build_prompt(
            event,
            asset_context
        )

        response = self.client.chat.completions.parse(
            model=self.model,
            temperature=0,
            messages=[
                {
                    "role": "system",
                    "content": SYSTEM_INSTRUCTION
                },
                {
                    "role": "user",
                    "content": prompt
                }
            ],
            response_format=EnrichmentResult
        )

        message = response.choices[0].message

        if getattr(message, "refusal", None):
            raise RuntimeError(
                f"OpenAI recusou a análise: "
                f"{message.refusal}"
            )

        if message.parsed is None:
            raise RuntimeError(
                "OpenAI não retornou uma resposta estruturada."
            )

        return message.parsed


# Anthropic / Claude API

class AnthropicProvider(LLMProvider):

    def __init__(self):
        import anthropic

        self.model = os.getenv(
            "ANTHROPIC_MODEL",
            "claude-sonnet-4-5"
        )

        self.client = anthropic.Anthropic(
            api_key=read_secret(
                "ANTHROPIC_API_KEY"
            )
        )

    def analyze(
        self,
        event: dict,
        asset_context: dict
    ) -> EnrichmentResult:

        prompt = build_prompt(
            event,
            asset_context
        )

        response = self.client.messages.create(
            model=self.model,
            max_tokens=1500,
            temperature=0,
            system=SYSTEM_INSTRUCTION,
            messages=[
                {
                    "role": "user",
                    "content": prompt
                }
            ],
            output_config={
                "format": {
                    "type": "json_schema",
                    "schema": EnrichmentResult.model_json_schema()
                }
            }
        )

        response_text = None

        for block in response.content:
            if getattr(
                block,
                "type",
                None
            ) == "text":

                response_text = block.text
                break

        if not response_text:
            raise RuntimeError(
                "Anthropic não retornou conteúdo textual."
            )

        return EnrichmentResult.model_validate_json(
            response_text
        )


# Provider Selection

def create_provider() -> LLMProvider:
    if LLM_PROVIDER == "openai":
        return OpenAIProvider()

    if LLM_PROVIDER == "gemini":
        return GeminiProvider()

    if LLM_PROVIDER in (
        "anthropic",
        "claude"
    ):
        return AnthropicProvider()

    raise RuntimeError(
        "LLM_PROVIDER inválido. "
        "Use: openai, gemini ou anthropic."
    )


# Final Event with Enriched Data

def build_enriched_event(
    event: dict,
    result: EnrichmentResult,
    asset_context: dict
) -> dict:

    alert = event.get(
        "alert",
        {}
    )

    return {
        "event_source": f"suricata_{LLM_PROVIDER}",
        "pipeline_version": "1",
        "event_type": "alert",

        "timestamp": event.get(
            "timestamp"
        ),

        "flow_id": event.get(
            "flow_id"
        ),

        "src_ip": event.get(
            "src_ip"
        ),

        "src_port": event.get(
            "src_port"
        ),

        "dest_ip": event.get(
            "dest_ip"
        ),

        "dest_port": event.get(
            "dest_port"
        ),

        "proto": event.get(
            "proto"
        ),

        "app_proto": event.get(
            "app_proto"
        ),

        "suricata": {
            "signature_id": alert.get(
                "signature_id"
            ),

            "signature": alert.get(
                "signature"
            ),

            "category": alert.get(
                "category"
            ),

            "severity": alert.get(
                "severity"
            ),

            "action": alert.get(
                "action"
            )
        },

        "enrichment": result.model_dump(),

        "asset": asset_context
    }


# Retry Processing

def process_event(
    provider: LLMProvider,
    event: dict
) -> None:

    asset_context = get_asset_context(
        event
    )

    last_error = None

    for attempt in range(
        1,
        MAX_RETRIES + 1
    ):

        try:
            result = provider.analyze(
                event=event,
                asset_context=asset_context
            )

            enriched_event = build_enriched_event(
                event=event,
                result=result,
                asset_context=asset_context
            )

            write_json_line(
                enriched_event
            )

            signature_id = event.get(
                "alert",
                {}
            ).get(
                "signature_id"
            )

            print(
                f"OK provider={LLM_PROVIDER} "
                f"signature_id={signature_id} "
                f"src={event.get('src_ip')} "
                f"dst={event.get('dest_ip')}",
                flush=True
            )

            return

        except Exception as error:
            last_error = error

            print(
                f"Attempt failed "
                f"{attempt}/{MAX_RETRIES}: "
                f"{error}",
                file=sys.stderr,
                flush=True
            )

            if attempt < MAX_RETRIES:
                time.sleep(
                    RETRY_SECONDS * attempt
                )

    raise RuntimeError(
        "Event not processed after "
        f"{MAX_RETRIES} attempts: "
        f"{last_error}"
    )


# Continuous Monitoring (Eve.json)

def follow_file(
    provider: LLMProvider
) -> None:

    print(
        f"Starting pipeline: "
        f"provider={LLM_PROVIDER} "
        f"input={INPUT_FILE} "
        f"output={OUTPUT_FILE}",
        flush=True
    )

    # External loop: reopens the file when it is
    # rotated (new inode) or recreated.
    while True:

        with INPUT_FILE.open(
            "r",
            encoding="utf-8"
        ) as source:

            # Starts at the end of the file and processes
            # only new events.
            source.seek(
                0,
                2
            )

            current_inode = os.fstat(
                source.fileno()
            ).st_ino

            while True:

                # Detects rotation: the file in the
                # path has a different inode
                # than the one we have open.
                try:
                    stat_now = INPUT_FILE.stat()

                except FileNotFoundError:
                    stat_now = None

                if (
                    stat_now is None
                    or stat_now.st_ino != current_inode
                ):
                    print(
                        "eve.json rotated/recreated. "
                        "Reopening file...",
                        flush=True
                    )
                    break

                # Detects in-place truncation
                # (Suricata restart, logrotate 
                # copytruncate): if the current size
                # is smaller than our read position,
                # we return to the beginning of the file.
                position = source.tell()

                if stat_now.st_size < position:
                    print(
                        f"eve.json truncated "
                        f"(posicao={position} "
                        f"tamanho={stat_now.st_size}). "
                        f"Going back to the beginning...",
                        flush=True
                    )
                    source.seek(0)

                line = source.readline()

                if not line:
                    time.sleep(
                        0.5
                    )
                    continue

                try:
                    event = json.loads(
                        line
                    )

                except json.JSONDecodeError as error:
                    print(
                        f"Invalid JSON line ignored: "
                        f"{error}",
                        file=sys.stderr,
                        flush=True
                    )
                    continue

                # Wazuh will only receive alerts.
                if event.get(
                    "event_type"
                ) != "alert":
                    continue

                try:
                    process_event(
                        provider,
                        event
                    )

                except Exception as error:
                    print(
                        f"Event discarded due to failures: "
                        f"{error}",
                        file=sys.stderr,
                        flush=True
                    )


# Entry Point

def main() -> None:

    if not INPUT_FILE.exists():
        raise FileNotFoundError(
            f"Input file does not exist: "
            f"{INPUT_FILE}"
        )

    provider = create_provider()

    follow_file(
        provider
    )


if __name__ == "__main__":
    main()







chown -R suricata:suricata /usr/local/etc/suricata-enricher
chmod 755 /usr/local/etc/suricata-enricher/ai_enricher.py

systemctl restart suricata-enricher
journalctl -u suricata-enricher -f

