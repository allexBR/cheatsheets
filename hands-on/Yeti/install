## Deploy YETI Threat Intel Platform ##


NOTE: You need to install Docker first!


cd /tmp && wget https://raw.githubusercontent.com/allexBR/cheatsheets/main/hands-on/Docker/install-docker.sh

chmod 744 install-docker.sh

bash install-docker.sh



docker run hello-world


-----------------------------------------------------------------------------------------


mv /usr/lib/python3.13/EXTERNALLY-MANAGED /usr/lib/python3.13/EXTERNALLY-MANAGED.bak

cd /opt

mkdir -p /opt/yeti

git clone https://github.com/yeti-platform/yeti /opt/yeti/app

git clone https://github.com/yeti-platform/yeti-feeds-frontend /opt/yeti/frontend

git clone https://github.com/yeti-platform/yeti-docker /opt/yeti/docker

mkdir -p /opt/yeti/bloomfilters

mkdir -p /opt/yeti/exports

cp /opt/yeti/app/yeti.conf.sample /opt/yeti/app/yeti.conf

nano /opt/yeti/app/yeti.conf

cd /opt/yeti/docker/prod

mv docker-compose.yaml docker-compose.yaml.bak

cat > /opt/yeti/docker/prod/docker-compose.yaml <<'EOF'
services:

  frontend:
    image: yetiplatform/yeti-frontend:local
    build:
      context: /opt/yeti/frontend
      dockerfile: docker/prod/Dockerfile
    ports:
      - 80:80
    volumes:
      - ./frontend/nginx.conf:/etc/nginx/conf.d/default.conf
    depends_on:
      - api

  api:
    image: yetiplatform/yeti:local
    build:
      context: /opt/yeti/app
      dockerfile: extras/docker/Dockerfile
    env_file:
      - ${YETI_DOCKER_ENVFILE}
    entrypoint:
      - /docker-entrypoint.sh
    command: ["webserver"]
    ports:
      - 8001:8000
    depends_on:
      - redis
      - arangodb
    volumes:
      - yeti-exports:/opt/yeti/exports
      - /opt/yeti/app/yeti.conf:/app/yeti.conf

  tasks:
    image: yetiplatform/yeti:local
    env_file:
      - ${YETI_DOCKER_ENVFILE}
    command: ['tasks']
    depends_on:
      - redis
      - arangodb
      - api
    volumes:
      - yeti-exports:/opt/yeti/exports
      - /opt/yeti/app/yeti.conf:/app/yeti.conf

  events-tasks:
    image: yetiplatform/yeti:local
    env_file:
      - ${YETI_DOCKER_ENVFILE}
    command: ['events-tasks']
    depends_on:
      - redis
      - arangodb
      - api
    volumes:
      - yeti-exports:/opt/yeti/exports

  tasks-beat:
    image: yetiplatform/yeti:local
    env_file:
      - ${YETI_DOCKER_ENVFILE}
    command: ['tasks-beat']
    depends_on:
      - redis

  redis:
    image: redis:latest

  arangodb:
    image: arangodb:3.11
    #image: arangodb:3.8.9
    container_name: arangodb
    restart: unless-stopped
    environment:
      - ARANGO_NO_AUTH=1
      - ARANGO_RANDOM_ROOT_PASSWORD=1
    volumes:
      - yeti-db:/var/lib/arangodb3
    ports:
      - "8529:8529"

  bloomcheck:
    image: yetiplatform/yeti:local
    env_file:
      - ${YETI_DOCKER_ENVFILE}
    command: ["bloomcheck"]
    volumes:
      - ${YETI_BLOOM_FILTERS_DIR}:/bloomfilters

  agents:
    image: yetiplatform/yeti:local
    env_file:
      - ${YETI_DOCKER_ENVFILE}
    environment:
      - YETI_AGENTS_DB_PATH=/data/sessions.db
    volumes:
      - yeti-agents-data:/data
    command: ["uv", "run", "uvicorn", "core.agent.main:app", "--host", "0.0.0.0", "--port", "8888"]

networks:
  default:
    name: yeti_prod_network

volumes:
  yeti-agents-data:
    driver: local
  yeti-exports:
    driver: local
  yeti-db:
    driver: local
EOF

----------------------------------------------------------------------------------------

SECRET_KEY=$(openssl rand -hex 64)
echo YETI_AUTH_SECRET_KEY=$SECRET_KEY >> .env

----------------------------------------------------------------------------------------

# Stop the containers from running
docker stop $(docker ps -aq)


# Clean up any residual containers from previous attempts
docker compose down --volumes --remove-orphans


# Physical command to clean up any orphaned traces in the host's Docker
docker volume rm $(docker volume ls -q | grep yeti) 2>/dev/null || true


# Run the build (this will download Python packages for the backend and NPM packages for the frontend)
docker compose build


# Spins up the entire infrastructure in the background
docker compose up -d --wait --quiet-pull

--------

# Spins up the entire infrastructure in the background
docker compose up -d


# Container Status
docker compose ps


# Stop container execution
docker compose stop


# Logs
docker compose logs -f --tail=20


# Create username and password for administration
docker compose run --rm api create-user USERNAME PASSWORD --admin

# Web GUI
http://localhost:80/

